# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser, NEVER prefixed with NEXT_PUBLIC_.
# Used only by supabase/seed.ts to create demo accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
