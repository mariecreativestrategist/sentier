# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings > Data API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-only, NEVER exposed to the browser, NEVER prefixed with NEXT_PUBLIC_.
# Used by the "add apprenant" server action (creates the learner's login account)
# and by supabase/seed.ts. Required in production (Vercel) too, not just locally.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — without these, the app works exactly the same, it just doesn't
# send emails (invitations, messages, corrections, session reminders).
# Get a key at resend.com > API Keys.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Sentier <onboarding@resend.dev>
# Where you (the coach) receive test notifications — your own Resend account email.
COACH_NOTIFICATION_EMAIL=

# Optional — protects /api/cron/session-reminders from being triggered by
# anyone else. Vercel sends this automatically as a Bearer token when set.
CRON_SECRET=
